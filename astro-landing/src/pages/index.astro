---
/**
 * GK Botanicals — cinematic landing page
 * Astro + Tailwind CSS v4 + Three.js + GSAP
 *
 * Imagery: every large image has an Unsplash URL (cinematic backgrounds) and a local
 * fallback in /public/images. If a remote URL fails, the <img> swaps to its fallback and the
 * CSS gradient underneath keeps the layout intact. Swap URLs in IMG below.
 */
import "../styles/global.css";

const unsplash = (id: string, w = 2400) =>
  `https://images.unsplash.com/${id}?auto=format&fit=crop&w=${w}&q=75`;

// TODO: replace with licensed / brand photography. Remote IDs are best-effort placeholders.
const IMG = {
  hero: { src: unsplash("photo-1448375240586-882707db888b"), fallback: "/images/ginger.webp" },
  aqueous: { src: unsplash("photo-1470071459604-3b5ec3a7fe05", 1800), fallback: "/images/ashwagandha.webp" },
  ethanol: { src: unsplash("photo-1532187863486-abf9dbad1b69", 1800), fallback: "/images/turmeric.webp" },
  co2: { src: unsplash("photo-1441974231531-c6227db76b6e", 1800), fallback: "/images/bacopa.webp" },
};

const ingredients = [
  {
    name: "Turmeric",
    latin: "Curcuma longa",
    active: "Curcumin",
    spec: "95% curcuminoids · HPLC",
    compounds: [
      ["Curcumin", "Primary curcuminoid"],
      ["Demethoxycurcumin", "Secondary curcuminoid"],
      ["Bisdemethoxycurcumin", "Minor curcuminoid"],
    ],
    img: "/images/turmeric.webp",
    pos: "45% 50%",
    span: "lg:col-span-2",
  },
  {
    name: "Ashwagandha",
    latin: "Withania somnifera",
    active: "Withanolides",
    spec: "2.5–10% withanolides · HPLC",
    compounds: [
      ["Withaferin A", "Signature steroidal lactone"],
      ["Withanolide A", "Marker withanolide"],
      ["Withanoside IV", "Glycosylated withanolide"],
    ],
    img: "/images/ashwagandha.webp",
    pos: "25% 50%",
    span: "lg:col-span-2",
  },
  {
    name: "Green Tea",
    latin: "Camellia sinensis",
    active: "EGCG",
    spec: "Catechins to 98% · EGCG-rich",
    compounds: [
      ["EGCG", "Epigallocatechin gallate"],
      ["EGC", "Epigallocatechin"],
      ["ECG", "Epicatechin gallate"],
    ],
    img: "/images/bacopa.webp",
    pos: "18% 50%",
    span: "lg:col-span-2",
  },
  {
    name: "Ginger",
    latin: "Zingiber officinale",
    active: "Gingerols",
    spec: "5–20% gingerols · HPLC",
    compounds: [
      ["6-Gingerol", "Principal pungent compound"],
      ["6-Shogaol", "Dehydrated derivative"],
      ["Zingerone", "Sweet-spicy phenolic"],
    ],
    img: "/images/ginger.webp",
    pos: "30% 60%",
    span: "lg:col-span-3",
  },
  {
    name: "Ginkgo Biloba",
    latin: "Ginkgo biloba",
    active: "Flavone glycosides",
    spec: "24% flavone glycosides · 6% terpene lactones",
    compounds: [
      ["Quercetin & kaempferol glycosides", "Flavonoid fraction"],
      ["Ginkgolides A · B · C", "Diterpene lactones"],
      ["Bilobalide", "Sesquiterpene lactone"],
    ],
    img: "/images/moringa.webp",
    pos: "22% 50%",
    span: "lg:col-span-3",
  },
];

const methods = [
  {
    n: "01",
    title: "Aqueous",
    kicker: "Water-based extraction",
    body: "Purified water at controlled temperature draws out polar actives — polysaccharides, catechins and saponins — with no residual solvent and a clean-label profile.",
    img: IMG.aqueous,
    specs: [
      ["Solvent", "Purified water"],
      ["Typical window", "60–100 °C"],
      ["Best for", "Green tea, ashwagandha"],
    ],
    flip: false,
  },
  {
    n: "02",
    title: "Ethanol",
    kicker: "Hydro-alcoholic extraction",
    body: "Food-grade ethanol/water blends reach a broad spectrum of mid-polarity compounds. Solvent is recovered and recycled, then removed to specification.",
    img: IMG.ethanol,
    specs: [
      ["Solvent", "Ethanol / water, 40–95%"],
      ["Typical window", "40–70 °C"],
      ["Best for", "Curcuminoids, gingerols, ginkgo"],
    ],
    flip: true,
  },
  {
    n: "03",
    title: "Supercritical CO₂",
    kicker: "Solvent-free precision",
    body: "Above 31 °C and 74 bar, carbon dioxide behaves like a tunable fluid. Selective, low-temperature and residue-free — ideal for delicate lipophilic actives.",
    img: IMG.co2,
    specs: [
      ["Solvent", "Carbon dioxide (scCO₂)"],
      ["Typical window", "40–60 °C · 100–350 bar"],
      ["Best for", "Ginger oleoresin, turmeric oils"],
    ],
    flip: false,
  },
];

const title = "GK Botanicals — Purity Meets Precision: Next-Generation Plant Extracts";
const description =
  "GK Botanicals manufactures standardised botanical extracts — turmeric, ashwagandha, green tea, ginger and ginkgo — using aqueous, ethanol and supercritical CO₂ extraction.";
---

<!doctype html>
<html lang="en" class="bg-ink scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050807" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "GK Botanicals",
        description,
      })}
    />
  </head>

  <body class="bg-ink font-sans text-slate-300 antialiased selection:bg-emerald-400/30">
    <!-- Custom cursor (hidden on touch devices; enabled by script) -->
    <div id="cursor-ring" aria-hidden="true">
      <span id="cursor-label"></span>
    </div>
    <div id="cursor-dot" aria-hidden="true"></div>

    <!-- Nav -->
    <header id="nav" class="fixed inset-x-0 top-0 z-50 transition-all duration-700">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 md:px-10" aria-label="Primary">
        <a href="#hero" class="flex items-center gap-3" data-cursor="link">
          <span class="grid h-9 w-9 place-items-center rounded-full border border-emerald-400/50 font-display text-lg text-emerald-200">GK</span>
          <span class="font-display text-xl tracking-wide text-white">GK Botanicals</span>
        </a>
        <ul class="hidden items-center gap-10 text-[11px] uppercase tracking-[.25em] text-slate-300 md:flex">
          <li><a href="#portfolio" data-cursor="link" class="transition hover:text-emerald-300">Portfolio</a></li>
          <li><a href="#technology" data-cursor="link" class="transition hover:text-emerald-300">Technology</a></li>
          <li><a href="#contact" data-cursor="link" class="transition hover:text-emerald-300">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <!-- ───────────── 1. HERO ───────────── -->
      <section id="hero" class="relative isolate flex min-h-screen items-center overflow-hidden">
        <!-- cinematic photo layer -->
        <div class="absolute inset-0 -z-30 bg-[radial-gradient(80%_60%_at_70%_40%,#0b3b2e_0%,#050807_70%)]"></div>
        <img
          id="hero-bg"
          src={IMG.hero.src}
          data-fallback={IMG.hero.fallback}
          alt=""
          fetchpriority="high"
          class="absolute inset-0 -z-20 h-[115%] w-full scale-105 object-cover opacity-50 [filter:brightness(.55)_saturate(.75)_contrast(1.1)]"
        />
        <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/70 via-transparent to-ink"></div>
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(60%_50%_at_20%_60%,rgba(5,8,7,.85),transparent)]"></div>

        <!-- Three.js canvas: supercritical CO₂ particles + bioactive molecules -->
        <canvas id="hero-canvas" class="pointer-events-none absolute inset-0 -z-[5] h-full w-full" aria-hidden="true"></canvas>

        <div id="hero-content" class="relative mx-auto w-full max-w-7xl px-6 pt-28 md:px-10">
          <p data-hero-fade class="mb-8 text-[11px] uppercase tracking-[.4em] text-emerald-300">
            Premium plant extract manufacturer
          </p>
          <h1 class="max-w-5xl font-display font-light leading-[.92] tracking-tight text-white">
            <span data-split class="block text-[15vw] sm:text-[11vw] lg:text-[8.5vw]">Purity Meets Precision:</span>
            <span data-split class="mt-3 block text-[8.5vw] italic text-emerald-200/90 sm:text-[6vw] lg:text-[4.6vw]">
              Next-Generation Plant Extracts.
            </span>
          </h1>
          <p data-hero-fade class="mt-10 max-w-xl text-lg font-light leading-relaxed text-slate-300/90">
            Standardised bioactives, extracted with aqueous, ethanol and supercritical CO₂ technology —
            traceable from field to certificate.
          </p>
          <div data-hero-fade class="mt-12 flex flex-wrap items-center gap-6">
            <a
              href="#portfolio"
              data-magnetic="0.35"
              data-cursor="link"
              class="inline-flex items-center gap-3 rounded-full border border-emerald-300/50 bg-emerald-400/10 px-9 py-4 text-xs uppercase tracking-[.25em] text-emerald-100 shadow-[0_0_40px_-8px_rgba(52,211,153,.6)] backdrop-blur-md transition-colors duration-500 hover:bg-emerald-400/25"
            >
              Explore the portfolio <span aria-hidden="true">→</span>
            </a>
            <a
              href="#technology"
              data-magnetic="0.25"
              data-cursor="link"
              class="inline-flex items-center rounded-full border border-white/15 px-8 py-4 text-xs uppercase tracking-[.25em] text-slate-200 backdrop-blur-md transition hover:bg-white/10"
            >
              Our technology
            </a>
          </div>
        </div>

        <div class="absolute bottom-8 right-6 hidden flex-col md:right-10 lg:flex items-center gap-3 text-[10px] uppercase tracking-[.4em] text-slate-400">
          Scroll
          <span class="h-10 w-px animate-pulse bg-gradient-to-b from-emerald-300 to-transparent"></span>
        </div>
      </section>

      <!-- ───────────── 2. BIOACTIVE PORTFOLIO ───────────── -->
      <section id="portfolio" class="relative px-6 py-32 md:px-10 lg:py-44">
        <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_40%_at_80%_10%,rgba(16,185,129,.12),transparent),linear-gradient(to_bottom,#050807,#07100d_50%,#050807)]"></div>
        <div class="mx-auto max-w-7xl">
          <p data-reveal class="mb-5 text-[11px] uppercase tracking-[.4em] text-emerald-300">01 — Bioactive portfolio</p>
          <h2 data-split class="max-w-3xl font-display text-5xl font-light leading-[.95] text-white md:text-7xl">
            Five botanicals. One standard of proof.
          </h2>
          <p data-reveal class="mt-8 max-w-xl text-slate-400">
            Hover or focus a card to reveal the marker compounds we standardise, and the typical
            specification range.
          </p>

          <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-6">
            {
              ingredients.map((p, i) => (
                <div class={`flip-wrap ${p.span}`} data-card data-magnetic="0.07" data-cursor="view">
                  <article
                    class="flip-card group relative h-[26rem] cursor-pointer outline-none [perspective:1400px]"
                    tabindex="0"
                    aria-label={`${p.name}: ${p.active}. ${p.spec}`}
                  >
                    <div class="flip-inner relative h-full w-full [transform-style:preserve-3d]">
                      {/* FRONT */}
                      <div class="face absolute inset-0 overflow-hidden rounded-3xl border border-white/10 bg-slate-900/40 [backface-visibility:hidden]">
                        <img
                          src={p.img}
                          alt={`${p.name} raw material and extract`}
                          loading="lazy"
                          style={`object-position:${p.pos}`}
                          class="card-img absolute inset-0 h-full w-full object-cover [filter:brightness(.8)_saturate(1.05)]"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent"></div>
                        <div class="card-spot pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
                        <div class="absolute inset-x-0 bottom-0 p-7">
                          <span class="text-[10px] uppercase tracking-[.35em] text-emerald-300">{String(i + 1).padStart(2, "0")} · {p.latin}</span>
                          <h3 class="mt-2 font-display text-4xl font-light text-white">{p.name}</h3>
                          <p class="mt-2 text-sm text-slate-300/80">Active: <span class="text-emerald-200">{p.active}</span></p>
                        </div>
                      </div>
                      {/* BACK */}
                      <div class="face back absolute inset-0 flex flex-col overflow-hidden rounded-3xl border border-emerald-300/30 bg-slate-950 p-7 [backface-visibility:hidden] [transform:rotateY(180deg)]">
                        <img src={p.img} alt="" aria-hidden="true" loading="lazy" style={`object-position:${p.pos}`} class="absolute inset-0 h-full w-full scale-125 object-cover opacity-25 blur-xl" />
                        <div class="absolute inset-0 bg-gradient-to-b from-slate-950/60 to-slate-950/90"></div>
                        <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-emerald-400/20 blur-3xl"></div>
                        <span class="relative text-[10px] uppercase tracking-[.35em] text-emerald-300">Marker compounds</span>
                        <h3 class="relative mt-2 font-display text-3xl font-light text-white">{p.active}</h3>
                        <ul class="relative mt-6 space-y-4">
                          {p.compounds.map(([n, d]) => (
                            <li class="compound border-l border-emerald-300/40 pl-4">
                              <div class="text-sm text-white">{n}</div>
                              <div class="text-xs text-slate-400">{d}</div>
                            </li>
                          ))}
                        </ul>
                        <div class="relative mt-auto rounded-xl border border-white/10 bg-black/20 px-4 py-3">
                          <div class="text-[10px] uppercase tracking-[.3em] text-slate-500">Typical specification</div>
                          <div class="mt-1 text-sm text-emerald-100">{p.spec}</div>
                        </div>
                      </div>
                    </div>
                  </article>
                </div>
              ))
            }
          </div>
          <p data-reveal class="mt-8 text-xs text-slate-600">
            Specifications shown are typical industry ranges for illustration; confirm against batch COA.
          </p>
        </div>
      </section>

      <!-- ───────────── 3. EXTRACTION TECHNOLOGY (PARALLAX) ───────────── -->
      <section id="technology" class="relative overflow-hidden py-32 lg:py-44">
        <div class="mx-auto max-w-7xl px-6 md:px-10">
          <p data-reveal class="mb-5 text-[11px] uppercase tracking-[.4em] text-emerald-300">02 — Extraction technology</p>
          <h2 data-split class="max-w-4xl font-display text-5xl font-light leading-[.95] text-white md:text-7xl">
            Three ways to release what plants hold.
          </h2>
        </div>

        {
          methods.map((m) => (
            <div class="tech-panel relative mx-auto mt-32 max-w-7xl px-6 md:px-10 lg:mt-48">
              <span
                class={`ghost pointer-events-none absolute -top-16 select-none font-display text-[22vw] font-light leading-none text-white/[.04] lg:-top-28 ${m.flip ? "left-4 md:left-10" : "right-4 md:right-10"}`}
                aria-hidden="true"
              >
                {m.n}
              </span>
              <div class={`relative grid items-center gap-10 lg:grid-cols-12 ${m.flip ? "lg:[direction:rtl]" : ""}`}>
                <div class="tech-media relative h-[26rem] overflow-hidden rounded-[2rem] border border-white/10 lg:col-span-7 lg:h-[34rem] lg:[direction:ltr]">
                  <div class="absolute inset-0 bg-[linear-gradient(135deg,#0b3b2e,#050807)]"></div>
                  <img
                    src={m.img.src}
                    data-fallback={m.img.fallback}
                    alt=""
                    loading="lazy"
                    class="tech-img absolute -inset-x-4 -inset-y-[12%] h-[124%] w-[calc(100%+2rem)] max-w-none object-cover [filter:brightness(.7)_saturate(.9)_contrast(1.1)]"
                  />
                  <div class="absolute inset-0 bg-gradient-to-tr from-ink/70 via-transparent to-emerald-900/20"></div>
                </div>
                <div class="tech-copy relative lg:col-span-5 lg:[direction:ltr]">
                  <div class={`tech-glass rounded-3xl border border-white/10 bg-white/[.04] p-8 backdrop-blur-2xl md:p-10 ${m.flip ? "lg:-mr-24" : "lg:-ml-24"}`}>
                    <p class="text-[11px] uppercase tracking-[.35em] text-emerald-300">{m.kicker}</p>
                    <h3 class="mt-3 font-display text-5xl font-light text-white md:text-6xl">{m.title}</h3>
                    <p class="mt-6 leading-relaxed text-slate-300/90">{m.body}</p>
                    <dl class="mt-8 divide-y divide-white/10 border-t border-white/10 text-sm">
                      {m.specs.map(([k, v]) => (
                        <div class="flex justify-between gap-6 py-3">
                          <dt class="text-slate-500">{k}</dt>
                          <dd class="text-right text-emerald-100">{v}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </section>
    </main>

    <!-- Footer / CTA -->
    <footer id="contact" class="relative overflow-hidden border-t border-white/10 px-6 py-32 text-center md:px-10">
      <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_50%_100%,rgba(16,185,129,.22),transparent)]"></div>
      <p data-reveal class="mb-6 text-[11px] uppercase tracking-[.4em] text-emerald-300">Let's talk</p>
      <h2 data-split class="mx-auto max-w-4xl font-display text-6xl font-light leading-[.95] text-white md:text-8xl">
        Request a sample or specification.
      </h2>
      <div data-reveal class="mt-12">
        <a
          href="mailto:sales@gkbotanicals.com"
          data-magnetic="0.35"
          data-cursor="link"
          class="inline-flex items-center gap-3 rounded-full border border-emerald-300/50 bg-emerald-400/10 px-10 py-5 text-xs uppercase tracking-[.25em] text-emerald-100 backdrop-blur-md transition hover:bg-emerald-400/25"
        >
          Contact GK Botanicals <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="mt-20 text-xs text-slate-600">© {new Date().getFullYear()} GK Botanicals</p>
    </footer>

    <style is:global>
      html.has-cursor,
      html.has-cursor * {
        cursor: none !important;
      }

      /* custom cursor */
      #cursor-ring,
      #cursor-dot {
        position: fixed;
        left: 0;
        top: 0;
        z-index: 1000;
        pointer-events: none;
        opacity: 0;
        will-change: transform;
      }
      html.has-cursor #cursor-ring,
      html.has-cursor #cursor-dot {
        opacity: 1;
      }
      #cursor-ring {
        width: 38px;
        height: 38px;
        border-radius: 999px;
        border: 1px solid rgba(110, 231, 183, 0.7);
        display: grid;
        place-items: center;
        transition:
          width 0.5s cubic-bezier(0.22, 1, 0.36, 1),
          height 0.5s cubic-bezier(0.22, 1, 0.36, 1),
          background 0.4s,
          border-color 0.4s;
        mix-blend-mode: normal;
      }
      #cursor-ring[data-state="link"] {
        width: 70px;
        height: 70px;
        background: rgba(16, 185, 129, 0.16);
        backdrop-filter: blur(3px);
      }
      #cursor-ring[data-state="view"] {
        width: 92px;
        height: 92px;
        background: rgba(255, 255, 255, 0.07);
        backdrop-filter: blur(4px);
        border-color: rgba(255, 255, 255, 0.5);
      }
      #cursor-ring[data-state="down"] {
        width: 26px;
        height: 26px;
      }
      #cursor-label {
        font-size: 10px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: #ecfdf5;
      }
      #cursor-dot {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: #6ee7b7;
        box-shadow: 0 0 12px 2px rgba(110, 231, 183, 0.8);
      }

      /* nav after scroll */
      #nav.is-scrolled {
        background: rgba(5, 8, 7, 0.55);
        backdrop-filter: blur(18px) saturate(140%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      /* avoid a flash of unstyled text before GSAP takes over */
      .js [data-split] {
        visibility: hidden;
      }
      .js [data-reveal],
      .js [data-card],
      .js [data-hero-fade] {
        opacity: 0;
      }

      /* split text */
      .w {
        display: inline-block;
        overflow: hidden;
        vertical-align: top;
        padding-bottom: 0.12em;
        margin-bottom: -0.12em;
      }
      .wi {
        display: inline-block;
        will-change: transform;
      }

      /* flip cards — glowing border + hover scale */
      .flip-card {
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .flip-card:hover,
      .flip-card:focus-visible {
        transform: scale(1.03);
      }
      .flip-card::before {
        content: "";
        position: absolute;
        inset: -1px;
        border-radius: 1.55rem;
        padding: 1px;
        background: conic-gradient(from var(--a, 0deg), #10b981, #a7f3d0, transparent 40%, #10b981);
        -webkit-mask:
          linear-gradient(#000 0 0) content-box,
          linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0;
        transition: opacity 0.5s;
        pointer-events: none;
        z-index: 2;
      }
      .flip-card:hover::before,
      .flip-card:focus-visible::before {
        opacity: 1;
        animation: spin 4s linear infinite;
      }
      .flip-card:focus-visible {
        outline: 2px solid #6ee7b7;
        outline-offset: 6px;
        border-radius: 1.5rem;
      }
      @property --a {
        syntax: "<angle>";
        inherits: false;
        initial-value: 0deg;
      }
      @keyframes spin {
        to {
          --a: 360deg;
        }
      }
      .card-spot {
        background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), rgba(110, 231, 183, 0.22), transparent 70%);
      }

      @media (prefers-reduced-motion: reduce) {
        .flip-card,
        .flip-card::before {
          transition: none;
          animation: none !important;
        }
      }
    </style>

    <!-- ───────────── CURSOR + MAGNETIC ───────────── -->
    <script>
      import gsap from "gsap";

      const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Swap failed remote images to their local fallback
      document.querySelectorAll<HTMLImageElement>("img[data-fallback]").forEach((img) => {
        const swap = () => {
          if (img.dataset.swapped) return;
          img.dataset.swapped = "1";
          img.src = img.dataset.fallback!;
        };
        if (img.complete && img.naturalWidth === 0) swap();
        img.addEventListener("error", swap, { once: true });
      });

      if (fine) {
        document.documentElement.classList.add("has-cursor");

        const ring = document.getElementById("cursor-ring")!;
        const dot = document.getElementById("cursor-dot")!;
        const label = document.getElementById("cursor-label")!;
        gsap.set([ring, dot], { xPercent: -50, yPercent: -50 });

        const dotX = gsap.quickTo(dot, "x", { duration: 0.1, ease: "power3" });
        const dotY = gsap.quickTo(dot, "y", { duration: 0.1, ease: "power3" });
        const ringX = gsap.quickTo(ring, "x", { duration: 0.55, ease: "power3" });
        const ringY = gsap.quickTo(ring, "y", { duration: 0.55, ease: "power3" });

        let mx = -100,
          my = -100,
          moved = false;

        window.addEventListener(
          "pointermove",
          (e) => {
            mx = e.clientX;
            my = e.clientY;
            moved = true;
            dotX(mx);
            dotY(my);
            ringX(mx);
            ringY(my);
          },
          { passive: true },
        );

        // Hover states via [data-cursor="link|view"]
        const setState = (s: string | null) => {
          if (s) ring.dataset.state = s;
          else delete ring.dataset.state;
          label.textContent = s === "view" ? "View" : "";
        };
        document.addEventListener("pointerover", (e) => {
          const t = (e.target as HTMLElement).closest<HTMLElement>("[data-cursor]");
          setState(t ? t.dataset.cursor! : null);
        });
        document.documentElement.addEventListener("mouseleave", () => setState(null));
        window.addEventListener("pointerdown", () => {
          if (!ring.dataset.state) ring.dataset.state = "down";
        });
        window.addEventListener("pointerup", () => {
          if (ring.dataset.state === "down") delete ring.dataset.state;
        });

        // Magnetic pull: elements drift toward the cursor as it approaches
        if (!reduce) {
          const items = Array.from(document.querySelectorAll<HTMLElement>("[data-magnetic]")).map((el) => ({
            el,
            strength: parseFloat(el.dataset.magnetic || "0.3"),
            pad: parseFloat(el.dataset.pad || "90"),
            x: gsap.quickTo(el, "x", { duration: 0.9, ease: "elastic.out(1, 0.45)" }),
            y: gsap.quickTo(el, "y", { duration: 0.9, ease: "elastic.out(1, 0.45)" }),
            active: false,
          }));

          gsap.ticker.add(() => {
            if (!moved) return;
            moved = false;
            for (const it of items) {
              const r = it.el.getBoundingClientRect();
              const curX = Number(gsap.getProperty(it.el, "x")) || 0;
              const curY = Number(gsap.getProperty(it.el, "y")) || 0;
              const cx = r.left - curX + r.width / 2;
              const cy = r.top - curY + r.height / 2;
              const dx = Math.max(r.left - curX - mx, 0, mx - (r.right - curX));
              const dy = Math.max(r.top - curY - my, 0, my - (r.bottom - curY));
              if (Math.hypot(dx, dy) < it.pad) {
                it.active = true;
                it.x((mx - cx) * it.strength);
                it.y((my - cy) * it.strength);
              } else if (it.active) {
                it.active = false;
                it.x(0);
                it.y(0);
              }
            }
          });
        }
      }
    </script>

    <!-- ───────────── THREE.JS HERO: scCO₂ PARTICLES + MOLECULES ───────────── -->
    <script>
      import * as THREE from "three";

      const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement;
      const hero = document.getElementById("hero") as HTMLElement;
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const isSmall = window.matchMedia("(max-width: 768px)").matches;

      const NOISE = /* glsl */ `
        vec3 mod289(vec3 x){return x-floor(x*(1./289.))*289.;}
        vec4 mod289(vec4 x){return x-floor(x*(1./289.))*289.;}
        vec4 permute(vec4 x){return mod289(((x*34.)+1.)*x);}
        vec4 taylorInvSqrt(vec4 r){return 1.79284291400159-.85373472095314*r;}
        float snoise(vec3 v){
          const vec2 C=vec2(1./6.,1./3.); const vec4 D=vec4(0.,.5,1.,2.);
          vec3 i=floor(v+dot(v,C.yyy)); vec3 x0=v-i+dot(i,C.xxx);
          vec3 g=step(x0.yzx,x0.xyz); vec3 l=1.-g; vec3 i1=min(g.xyz,l.zxy); vec3 i2=max(g.xyz,l.zxy);
          vec3 x1=x0-i1+C.xxx; vec3 x2=x0-i2+C.yyy; vec3 x3=x0-D.yyy;
          i=mod289(i);
          vec4 p=permute(permute(permute(i.z+vec4(0.,i1.z,i2.z,1.))+i.y+vec4(0.,i1.y,i2.y,1.))+i.x+vec4(0.,i1.x,i2.x,1.));
          float n_=.142857142857; vec3 ns=n_*D.wyz-D.xzx;
          vec4 j=p-49.*floor(p*ns.z*ns.z); vec4 x_=floor(j*ns.z); vec4 y_=floor(j-7.*x_);
          vec4 x=x_*ns.x+ns.yyyy; vec4 y=y_*ns.x+ns.yyyy; vec4 h=1.-abs(x)-abs(y);
          vec4 b0=vec4(x.xy,y.xy); vec4 b1=vec4(x.zw,y.zw);
          vec4 s0=floor(b0)*2.+1.; vec4 s1=floor(b1)*2.+1.; vec4 sh=-step(h,vec4(0.));
          vec4 a0=b0.xzyw+s0.xzyw*sh.xxyy; vec4 a1=b1.xzyw+s1.xzyw*sh.zzww;
          vec3 p0=vec3(a0.xy,h.x); vec3 p1=vec3(a0.zw,h.y); vec3 p2=vec3(a1.xy,h.z); vec3 p3=vec3(a1.zw,h.w);
          vec4 norm=taylorInvSqrt(vec4(dot(p0,p0),dot(p1,p1),dot(p2,p2),dot(p3,p3)));
          p0*=norm.x; p1*=norm.y; p2*=norm.z; p3*=norm.w;
          vec4 m=max(.6-vec4(dot(x0,x0),dot(x1,x1),dot(x2,x2),dot(x3,x3)),0.); m=m*m;
          return 42.*dot(m*m,vec4(dot(p0,x0),dot(p1,x1),dot(p2,x2),dot(p3,x3)));
        }
      `;

      const VERT = /* glsl */ `
        uniform float uTime, uPixelRatio, uSize, uRadius, uStrength, uW;
        uniform vec3 uMouse;
        attribute vec4 aRand;
        varying float vAlpha, vMix;
        ${NOISE}
        void main(){
          vec3 p = position;
          // laminar drift with per-particle speed, wrapped across the scene
          p.x = mod(p.x + uTime*(0.16 + aRand.x*0.4) + uW, 2.*uW) - uW;
          // organic turbulence (curl-ish noise)
          float n1 = snoise(vec3(p.x*.2, p.y*.22, uTime*.11 + aRand.y*4.));
          float n2 = snoise(vec3(p.y*.22+13., p.z*.2, uTime*.1));
          p.y += n1*1.7 + sin(p.x*.55 + uTime*.55 + aRand.z*6.283)*.28;
          p.z += n2*1.7;
          // slow vortex — the supercritical "phase" swirling
          vec2 c = vec2(sin(uTime*.09)*2.6, cos(uTime*.12)*1.1);
          vec2 d = p.xy - c; float r = length(d);
          float ang = 1.1/(1.+r*r*.32) * sin(uTime*.22);
          p.xy = c + mat2(cos(ang),-sin(ang),sin(ang),cos(ang))*d;
          // cursor repulsion
          vec2 md = p.xy - uMouse.xy; float dist = length(md);
          float f = smoothstep(uRadius, 0., dist);
          p.xy += normalize(md + 1e-4) * f*f * uStrength;
          p.z  += f * .9;
          vec4 mv = modelViewMatrix*vec4(p,1.);
          gl_Position = projectionMatrix*mv;
          gl_PointSize = uSize*(.45+aRand.w*1.15)*uPixelRatio*(9./-mv.z)*(1.+f*.9);
          vAlpha = (.22+.78*aRand.w)*(.72+.28*n1) + f*.35;
          vMix = aRand.z;
        }
      `;

      const FRAG = /* glsl */ `
        precision highp float;
        varying float vAlpha, vMix;
        uniform vec3 uA, uB, uC;
        void main(){
          vec2 uv = gl_PointCoord-.5; float d = length(uv);
          if(d>.5) discard;
          float a = pow(smoothstep(.5,0.,d),1.9)*vAlpha;
          vec3 col = vMix<.72 ? mix(uA,uB,vMix/.72) : mix(uB,uC,(vMix-.72)/.28);
          gl_FragColor = vec4(col,a);
        }
      `;

      let renderer: THREE.WebGLRenderer | null = null;
      try {
        renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: "high-performance" });
      } catch {
        canvas.style.display = "none"; // WebGL unavailable: hero still works with photo + gradient
      }

      if (renderer) {
        renderer.setClearColor(0x000000, 0);
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
        camera.position.set(0, 0, 9);

        // ── particles
        const COUNT = isSmall ? 4500 : 15000;
        const W = 14;
        const pos = new Float32Array(COUNT * 3);
        const rnd = new Float32Array(COUNT * 4);
        for (let i = 0; i < COUNT; i++) {
          pos[i * 3] = (Math.random() * 2 - 1) * W;
          pos[i * 3 + 1] = (Math.random() * 2 - 1) * 5.2;
          pos[i * 3 + 2] = (Math.random() * 2 - 1) * 4;
          rnd.set([Math.random(), Math.random(), Math.random(), Math.pow(Math.random(), 2.2)], i * 4);
        }
        const geo = new THREE.BufferGeometry();
        geo.setAttribute("position", new THREE.BufferAttribute(pos, 3));
        geo.setAttribute("aRand", new THREE.BufferAttribute(rnd, 4));

        const uniforms = {
          uTime: { value: 0 },
          uPixelRatio: { value: 1 },
          uSize: { value: 5.5 },
          uRadius: { value: 2.6 },
          uStrength: { value: 1.5 },
          uW: { value: W },
          uMouse: { value: new THREE.Vector3(999, 999, 0) },
          uA: { value: new THREE.Color("#0f766e") }, // deep teal
          uB: { value: new THREE.Color("#34d399") }, // emerald
          uC: { value: new THREE.Color("#fde68a") }, // warm gold highlight
        };
        const mat = new THREE.ShaderMaterial({
          uniforms,
          vertexShader: VERT,
          fragmentShader: FRAG,
          transparent: true,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
        });
        scene.add(new THREE.Points(geo, mat));

        // ── bioactive molecules (stylised: two aromatic rings + linker, curcumin-inspired)
        scene.add(new THREE.AmbientLight(0xffffff, 0.5));
        const key = new THREE.PointLight(0x6ee7b7, 40, 30);
        key.position.set(4, 4, 6);
        scene.add(key);
        const rim = new THREE.PointLight(0xfde68a, 25, 30);
        rim.position.set(-5, -3, 4);
        scene.add(rim);

        const atomGeo = new THREE.SphereGeometry(1, 20, 20);
        const bondGeo = new THREE.CylinderGeometry(1, 1, 1, 8, 1);
        const atomMats = [
          new THREE.MeshStandardMaterial({ color: 0x34d399, emissive: 0x065f46, emissiveIntensity: 0.7, roughness: 0.35, metalness: 0.2 }),
          new THREE.MeshStandardMaterial({ color: 0xfde68a, emissive: 0x854d0e, emissiveIntensity: 0.6, roughness: 0.35, metalness: 0.3 }),
        ];
        const bondMat = new THREE.MeshStandardMaterial({ color: 0x99f6e4, emissive: 0x0f766e, emissiveIntensity: 0.5, roughness: 0.5, transparent: true, opacity: 0.85 });

        function hexRing(cx: number, cy: number): [number, number][] {
          return Array.from({ length: 6 }, (_, k) => [cx + Math.cos((k * Math.PI) / 3) * 0.55, cy + Math.sin((k * Math.PI) / 3) * 0.55] as [number, number]);
        }
        function buildMolecule(): THREE.Group {
          const g = new THREE.Group();
          const atoms: THREE.Vector3[] = [];
          const bonds: [number, number][] = [];
          const ringA = hexRing(-1.7, 0);
          const ringB = hexRing(1.7, 0);
          [ringA, ringB].forEach((ring) => {
            const base = atoms.length;
            ring.forEach(([x, y]) => atoms.push(new THREE.Vector3(x, y, 0)));
            for (let k = 0; k < 6; k++) bonds.push([base + k, base + ((k + 1) % 6)]);
          });
          const chain = [
            [-0.85, 0.35], [-0.35, -0.3], [0.15, 0.35], [0.65, -0.3], [1.15, 0.2],
          ];
          const cBase = atoms.length;
          chain.forEach(([x, y]) => atoms.push(new THREE.Vector3(x, y, 0.12)));
          bonds.push([0, cBase], [cBase + 4, 6 + 3]);
          for (let k = 0; k < chain.length - 1; k++) bonds.push([cBase + k, cBase + k + 1]);
          atoms.forEach((v, i) => {
            const m = new THREE.Mesh(atomGeo, atomMats[i >= cBase && i % 2 ? 1 : 0]);
            m.position.copy(v);
            m.scale.setScalar(i >= cBase ? 0.13 : 0.1);
            g.add(m);
          });
          const up = new THREE.Vector3(0, 1, 0);
          bonds.forEach(([a, b]) => {
            const A = atoms[a], B = atoms[b];
            const m = new THREE.Mesh(bondGeo, bondMat);
            m.position.copy(A).add(B).multiplyScalar(0.5);
            const dir = B.clone().sub(A);
            m.scale.set(0.028, dir.length(), 0.028);
            m.quaternion.setFromUnitVectors(up, dir.normalize());
            g.add(m);
          });
          return g;
        }

        type Mol = { g: THREE.Group; base: THREE.Vector3; off: THREE.Vector2; vel: THREE.Vector2; spin: THREE.Vector3; phase: number };
        const mols: Mol[] = [];
        const slots: [number, number, number, number][] = [
          [-5.4, 2.4, -2.2, 0.55], [4.9, 2.9, -3, 0.5], [5.6, -2.2, -1.6, 0.62],
          [-4.2, -2.9, -2.6, 0.5], [0.4, 3.6, -4, 0.4], [-0.6, -3.6, -3.4, 0.42],
        ];
        (isSmall ? slots.slice(0, 3) : slots).forEach(([x, y, z, s], i) => {
          const g = buildMolecule();
          g.scale.setScalar(s);
          g.position.set(x, y, z);
          g.rotation.set(Math.random() * 3, Math.random() * 3, Math.random() * 3);
          scene.add(g);
          mols.push({
            g, base: new THREE.Vector3(x, y, z), off: new THREE.Vector2(), vel: new THREE.Vector2(),
            spin: new THREE.Vector3(0.05 + Math.random() * 0.12, 0.08 + Math.random() * 0.14, 0.03 + Math.random() * 0.07),
            phase: i * 1.7,
          });
        });

        // ── pointer → world plane (z = 0)
        const ndc = new THREE.Vector2(9, 9);
        const mouseWorld = new THREE.Vector2(999, 999);
        window.addEventListener(
          "pointermove",
          (e) => {
            const r = hero.getBoundingClientRect();
            ndc.set(((e.clientX - r.left) / r.width) * 2 - 1, -(((e.clientY - r.top) / r.height) * 2 - 1));
          },
          { passive: true },
        );
        hero.addEventListener("pointerleave", () => ndc.set(9, 9));

        // ── sizing
        function resize() {
          const w = hero.clientWidth, h = hero.clientHeight;
          const dpr = Math.min(window.devicePixelRatio || 1, 1.75);
          renderer!.setPixelRatio(dpr);
          renderer!.setSize(w, h, false);
          uniforms.uPixelRatio.value = dpr;
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
        }
        resize();
        new ResizeObserver(resize).observe(hero);

        // ── loop (paused when hero is off-screen / tab hidden)
        let visible = true;
        new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0 }).observe(hero);

        const clock = new THREE.Clock();
        let t = 0;
        const halfH = Math.tan(THREE.MathUtils.degToRad(camera.fov / 2)) * camera.position.z;

        function frame() {
          requestAnimationFrame(frame);
          if (!visible || document.hidden) {
            clock.getDelta();
            return;
          }
          const dt = Math.min(clock.getDelta(), 0.05);
          t += reduce ? 0 : dt;
          uniforms.uTime.value = t + 20;

          // smooth cursor in world units
          const tx = ndc.x * halfH * camera.aspect;
          const ty = ndc.y * halfH;
          mouseWorld.x += (tx - mouseWorld.x) * Math.min(1, dt * 7);
          mouseWorld.y += (ty - mouseWorld.y) * Math.min(1, dt * 7);
          uniforms.uMouse.value.set(reduce ? 999 : mouseWorld.x, reduce ? 999 : mouseWorld.y, 0);

          // camera parallax
          camera.position.x += ((ndc.x > 5 ? 0 : ndc.x) * 0.7 - camera.position.x) * Math.min(1, dt * 2);
          camera.position.y += ((ndc.y > 5 ? 0 : ndc.y) * 0.4 - camera.position.y) * Math.min(1, dt * 2);
          camera.lookAt(0, 0, 0);

          // molecules: drift, spin, spring away from the cursor
          for (const m of mols) {
            const px = m.base.x + m.off.x, py = m.base.y + m.off.y;
            const dx = px - mouseWorld.x, dy = py - mouseWorld.y;
            const d = Math.hypot(dx, dy);
            const f = d < 3.2 ? (1 - d / 3.2) ** 2 : 0;
            if (!reduce && f > 0) {
              m.vel.x += (dx / (d || 1)) * f * 9 * dt;
              m.vel.y += (dy / (d || 1)) * f * 9 * dt;
            }
            m.vel.x += -m.off.x * 3 * dt;
            m.vel.y += -m.off.y * 3 * dt;
            m.vel.multiplyScalar(0.93);
            m.off.x += m.vel.x;
            m.off.y += m.vel.y;
            m.g.position.set(
              m.base.x + m.off.x + Math.sin(t * 0.3 + m.phase) * 0.35,
              m.base.y + m.off.y + Math.cos(t * 0.25 + m.phase) * 0.3,
              m.base.z,
            );
            m.g.rotation.x += m.spin.x * dt * (1 + f * 4);
            m.g.rotation.y += m.spin.y * dt * (1 + f * 4);
            m.g.rotation.z += m.spin.z * dt;
          }

          renderer!.render(scene, camera);
        }
        frame();
      }
    </script>

    <!-- ───────────── GSAP: SCROLL REVEALS, FLIP CARDS, PARALLAX ───────────── -->
    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const coarse = window.matchMedia("(hover: none)").matches;

      // Split text into masked words (keeps inline elements intact)
      function splitWords(root: HTMLElement) {
        const walk = (node: Node) => {
          Array.from(node.childNodes).forEach((n) => {
            if (n.nodeType === 3) {
              const frag = document.createDocumentFragment();
              (n.textContent || "").split(/(\s+)/).forEach((tok) => {
                if (!tok.trim()) return frag.append(document.createTextNode(tok));
                const w = document.createElement("span");
                w.className = "w";
                const wi = document.createElement("span");
                wi.className = "wi";
                wi.textContent = tok;
                w.append(wi);
                frag.append(w);
              });
              n.replaceWith(frag);
            } else if (n.nodeType === 1) walk(n);
          });
        };
        walk(root);
        return Array.from(root.querySelectorAll<HTMLElement>(".wi"));
      }

      const heroSplits = Array.from(document.querySelectorAll<HTMLElement>("#hero [data-split]")).map(splitWords);
      const otherSplits = Array.from(document.querySelectorAll<HTMLElement>("[data-split]"))
        .filter((el) => !el.closest("#hero"))
        .map((el) => ({ el, words: splitWords(el) }));

      document.querySelectorAll<HTMLElement>("[data-split]").forEach((el) => (el.style.visibility = "visible"));

      // Nav state
      ScrollTrigger.create({
        start: 60,
        end: "max",
        onToggle: (self) => document.getElementById("nav")!.classList.toggle("is-scrolled", self.isActive),
      });

      if (reduce) {
        // Everything visible, no motion
        document.querySelectorAll<HTMLElement>("[data-reveal],[data-hero-fade],[data-card]").forEach((el) => (el.style.opacity = "1"));
      } else {
        // ── Hero intro
        const intro = gsap.timeline({ defaults: { ease: "power4.out" }, delay: 0.2 });
        intro
          .from("#hero-bg", { opacity: 0, scale: 1.25, duration: 2.4, ease: "power2.out" }, 0)
          .from("#hero-canvas", { opacity: 0, duration: 2 }, 0.3)
          .from(heroSplits[0], { yPercent: 115, duration: 1.3, stagger: 0.09 }, 0.5)
          .from(heroSplits[1], { yPercent: 115, duration: 1.2, stagger: 0.06 }, 0.9)
          .fromTo("[data-hero-fade]", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 1.1, stagger: 0.14 }, 1.1);

        // Hero exits with depth as you scroll
        gsap.to("#hero-content", {
          yPercent: -18,
          opacity: 0,
          ease: "none",
          scrollTrigger: { trigger: "#hero", start: "top top", end: "bottom top", scrub: true },
        });
        gsap.to("#hero-bg", {
          yPercent: 12,
          ease: "none",
          scrollTrigger: { trigger: "#hero", start: "top top", end: "bottom top", scrub: true },
        });

        // ── Generic reveals
        gsap.set("[data-reveal]", { opacity: 0, y: 40 });
        ScrollTrigger.batch("[data-reveal]", {
          start: "top 88%",
          once: true,
          onEnter: (els) => gsap.to(els, { opacity: 1, y: 0, duration: 1.1, stagger: 0.12, ease: "power3.out", overwrite: true }),
        });

        otherSplits.forEach(({ el, words }) => {
          gsap.from(words, {
            yPercent: 115,
            duration: 1.1,
            stagger: 0.045,
            ease: "power4.out",
            scrollTrigger: { trigger: el, start: "top 85%", once: true },
          });
        });

        // ── Staggered card entrance
        gsap.set("[data-card]", { opacity: 0, y: 70, scale: 0.95 });
        ScrollTrigger.batch("[data-card]", {
          start: "top 90%",
          once: true,
          onEnter: (els) =>
            gsap.to(els, {
              opacity: 1,
              y: 0,
              scale: 1,
              duration: 1.2,
              stagger: 0.14,
              ease: "expo.out",
              overwrite: true,
              clearProps: "scale",
            }),
        });

        // ── Parallax: image, copy and ghost numeral all travel at different speeds
        document.querySelectorAll<HTMLElement>(".tech-panel").forEach((panel) => {
          const st = { trigger: panel, start: "top bottom", end: "bottom top", scrub: 0.6 };
          const img = panel.querySelector(".tech-img");
          const copy = panel.querySelector(".tech-glass");
          const ghost = panel.querySelector(".ghost");
          const media = panel.querySelector(".tech-media");
          if (img) gsap.fromTo(img, { yPercent: -9, scale: 1.08 }, { yPercent: 9, scale: 1.22, ease: "none", scrollTrigger: st });
          if (copy) gsap.fromTo(copy, { y: 110 }, { y: -110, ease: "none", scrollTrigger: st });
          if (ghost) gsap.fromTo(ghost, { y: 160, x: -30 }, { y: -160, x: 30, ease: "none", scrollTrigger: st });
          if (media) gsap.fromTo(media, { y: 50 }, { y: -50, ease: "none", scrollTrigger: st });
          // reveal
          gsap.from([media, copy].filter(Boolean), {
            opacity: 0,
            duration: 1.4,
            stagger: 0.2,
            ease: "power3.out",
            scrollTrigger: { trigger: panel, start: "top 75%", once: true },
          });
        });
      }

      // ── Flip cards: hover / focus (mouse & keyboard) or tap (touch)
      document.querySelectorAll<HTMLElement>(".flip-card").forEach((card) => {
        const inner = card.querySelector<HTMLElement>(".flip-inner")!;
        const items = card.querySelectorAll<HTMLElement>(".compound");
        let flipped = false;
        gsap.set(items, { opacity: 0, x: -14 });

        const flip = (to: boolean) => {
          if (flipped === to) return;
          flipped = to;
          gsap.to(inner, { rotateY: to ? 180 : 0, duration: reduce ? 0.01 : 0.95, ease: "power3.inOut", overwrite: "auto" });
          gsap.to(items, {
            opacity: to ? 1 : 0,
            x: to ? 0 : -14,
            duration: to ? 0.6 : 0.25,
            stagger: to ? 0.1 : 0,
            delay: to ? 0.45 : 0,
            ease: "power2.out",
            overwrite: "auto",
          });
          card.setAttribute("aria-pressed", String(to));
        };

        if (!coarse) {
          card.addEventListener("pointerenter", () => flip(true));
          card.addEventListener("pointerleave", () => flip(false));
        } else {
          card.addEventListener("click", () => flip(!flipped));
        }
        card.addEventListener("focus", () => flip(true));
        card.addEventListener("blur", () => flip(false));
        card.addEventListener("keydown", (e) => {
          if (e.key === "Escape") flip(false);
        });

        // pointer-follow spotlight on the front face
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${e.clientX - r.left}px`);
          card.style.setProperty("--my", `${e.clientY - r.top}px`);
        });
      });

      // ScrollTrigger needs a refresh once fonts/images settle
      window.addEventListener("load", () => ScrollTrigger.refresh());
    </script>
  </body>
</html>
